class RubyBikes
  module Native
    DATA: String
    type bounds = Hash[String, untyped] | Array[untyped] | nil

    module Geometry
      def self?.contains?: (bounds, Float, Float) -> bool
      def self?.polygon?: (untyped, Float, Float) -> bool
      def self?.ring: (untyped, Float, Float) -> (:inside | :outside | :boundary)
    end

class ResponseCache
  @ttl: Integer | Float
  @max_bytes: Integer
  @max_entries: Integer
  @entries: Hash[untyped, Entry]
  @bytes: Integer
  @mutex: Mutex
  class Entry < Struct[untyped]
    attr_accessor response: Transport::Response
    attr_accessor stored_at: Float
    attr_accessor bytes: Integer
    def self.new: (response: Transport::Response, stored_at: Float, bytes: Integer) -> Entry
    def initialize: (response: Transport::Response, stored_at: Float, bytes: Integer) -> void
  end
  def initialize: (?ttl: Integer | Float, ?max_bytes: Integer, ?max_entries: Integer) -> void
  def get: (untyped, Float) -> Transport::Response?
  def put: (untyped, Transport::Response, Float) -> void
  private
  def atomic: [A] () { () -> A } -> A
  def expire: (Float) -> void
end

    class Transport
      @clock: ^() -> Float
      @deadline: Float
      @headers: Hash[String, String]
      @proxy: URI::Generic?
      @cooldowns: Hash[String, Float]
      @cookies: untyped
      @cache: ResponseCache
      @last_response: Response
      @deadline_active: bool
      attr_reader headers: Hash[String, String]
      attr_reader last_response: Response
      class Response < Struct[untyped]
        attr_accessor status: Integer
        attr_accessor headers: Hash[String, String]
        attr_accessor body: String
        def self.new: (status: Integer, headers: Hash[String, String], body: String) -> Response
        def initialize: (status: Integer, headers: Hash[String, String], body: String) -> void
      end
      def initialize: (?timeout: Numeric, ?headers: Hash[String, String], ?proxy: String?, ?cooldowns: Hash[String, Float], ?cache: ResponseCache?, ?clock: ^() -> Float) -> void
      def remaining: () -> Float
      def within_deadline: [A] () { () -> A } -> A
      def request: (String, ?method: String, ?params: untyped, ?data: untyped, ?headers: Hash[String, String], ?raw: bool, ?skip_cache: bool, ?default_encoding: String) -> String
      private
      def perform_request: (String, method: String, params: untyped, data: untyped, headers: Hash[String, String], raw: bool, skip_cache: bool, default_encoding: String) -> String
      def decode: (Response, bool, String) -> String
      def transport_uri: (String) -> URI::HTTP
      def fetch: (URI::HTTP, String, untyped, Hash[String, String], Integer) -> Response
    end

    class Provider
      @spec: object
      @parameters: object
      @tag: String
      @meta: object
      @key: untyped
      @transport: Transport
      @stations: Array[station_row]
      @vehicles: Array[vehicle_row]
      attr_reader tag: String
      attr_reader meta: object
      attr_reader spec: object
      attr_reader parameters: object
      def initialize: (object, object, ?key: api_key) -> void
      def snapshot: (Transport) -> object
      def update: () -> void
      def station: (String?, untyped, untyped, ?Integer?, ?Integer?, ?object) -> Array[station_row]?
      def vehicle: (untyped, untyped, ?object, ?String) -> Array[vehicle_row]?
      def request: (String, **untyped) -> String
      def json: (String, **untyped) -> untyped
      def xml: (String, **untyped) -> untyped
      def html: (String, **untyped) -> untyped
      def p: (String, ?untyped) -> untyped
      def number: (untyped) -> Integer
      def list: (untyped) -> Array[untyped]
      def integer: (untyped) -> Integer?
      def truthy?: (untyped) -> bool?
      def iso_date: (untyped) -> String?
    end

    class Gbfs < Provider
      @feed_url: String
      def initialize: (object, object, ?key: api_key) -> void
      def update: () -> void
      def vehicle_kind: (object) -> [String?, String?]
      private
      def discover_feeds: (untyped) -> Hash[String, String]
      def parse_gbfs_station: (object, object) -> void
    end

    class Nextbike < Provider
      def update: () -> void
    end

