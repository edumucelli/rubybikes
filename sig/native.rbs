      def update_baksi: () -> void
      def update_batumvelo: () -> void
      def update_bicicard: () -> void
      def update_bicicas: () -> void
      def update_bicielx: () -> void
      def update_biciferrolterra: () -> void
      def update_bicimad: () -> void
      def update_bicincitta: () -> void
      def update_bicing: () -> void
      def update_bikeshare_ie: () -> void
      def update_bikeu: () -> void
      def update_bixi: () -> void
      def update_charichari: () -> void
      def update_chartered_bike: () -> void
      def update_clujbike: () -> void
      def update_cyclopolis: () -> void
      def update_cyclopolis_api: () -> void
      def update_cykleo: () -> void
      def update_decobike: () -> void
      def update_digitransit: () -> void
      def update_easybike: () -> void
      def update_emovity: () -> void
      def update_encicla: () -> void
      def update_fifteen: () -> void
      def update_fsm: () -> void
      def update_ganxeta: () -> void
      def update_gira: () -> void
      def update_gyorbike: () -> void
      def update_joco: () -> void
      def update_keolis: () -> void
      def update_kolumbus: () -> void
      def update_lastenvelo: () -> void
      def update_linkbike: () -> void
      def update_meiob: () -> void
      def update_mobhis: () -> void
      def update_movus: () -> void
      def update_nubija: () -> void
      def update_open_source_bike_share: () -> void
      def update_openmove: () -> void
      def update_otp: () -> void
      def update_ov_fiets: () -> void
      def update_pedalada: () -> void
      def update_publibike: () -> void
      def update_qrobici: () -> void
      def update_roovee: () -> void
      def update_samba: () -> void
      def update_sejong: () -> void
      def update_seoulbike: () -> void
      def update_slovnaft_bajk: () -> void
      def update_smartbike: () -> void
      def update_smoove: () -> void
      def update_soltrafego: () -> void
      def update_tashu: () -> void
      def update_urbansharing: () -> void
      def update_velobike_kz: () -> void
      def update_velok: () -> void
      def update_veloway: () -> void
      def update_weelo: () -> void
      def update_wegoshare: () -> void
      def update_xian: () -> void
      def update_yelovelo: () -> void
      def update_youbike: () -> void
      def lower_keys: (untyped) -> untyped
      def graphql: (String, String, ?object, ?operation: String?) -> untyped
      def otp_type: (object) -> [String?, String]
      private
      def html_scan: (String, Regexp) -> Array[untyped]
      def html_match: (String, Regexp) -> MatchData
      def html_capture: (String, Regexp) -> String
      def html_text: (untyped, String) -> String
      def gyorbike_count: (untyped, String) -> Integer
      def velobike_number: (untyped) -> Integer
      def detail_xml: (String, **untyped) -> untyped
      def xml_text: (untyped, String) -> untyped
      def xml_boolean?: (String) -> bool
      def bicincitta_coordinate: (String) -> Float
      def pedalada_status: (object) -> String
      def cyclopolis_count: (String) -> Integer
    end

    class DataLiteral
      @scanner: StringScanner
      def self.parse: (String) -> json
      def initialize: (String) -> void
      def parse: () -> json
      private
      def whitespace: () -> Integer?
      def value: (Integer) -> json
      def sequence: (Integer, String) -> Array[json]
      def string: () -> String
    end

    class Engine
      MANIFEST: object
      @timeout: Float
      @providers: Array[object]
      @definitions: Hash[String, object]
      @mutex: Mutex
      @cooldowns: Hash[String, Float]
      @systems: Hash[String, Provider]
      @response_cache: ResponseCache
      attr_reader timeout: Float
      def initialize: (?timeout: Numeric) -> void
      def request: (String, ?timeout: Numeric, **untyped) -> untyped
      def close: () -> void
      private
      def catalog_instances: (untyped) -> Array[untyped]
      def find_spec: (object) -> object
    end
  end
end
