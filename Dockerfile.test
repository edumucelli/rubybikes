FROM ruby:3.4-slim-trixie@sha256:3a8122c4267d89a95b1ce0f3029b44e325180314661856300d29d3e8a80ec46f
RUN apt-get update && apt-get install -y --no-install-recommends build-essential \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /rubybikes
COPY Gemfile rubybikes.gemspec ./
COPY lib ./lib
COPY data ./data
COPY sig ./sig
COPY LICENSE NOTICE README.md CHANGELOG.md CONTRIBUTING.md PROVIDERS.md RELEASING.md ./
RUN bundle install
COPY test ./test
COPY bin ./bin
COPY .github/scripts ./.github/scripts
COPY Rakefile ./
CMD ["sh", "-c", "COVERAGE=1 VERIFY_PROVIDER_COVERAGE=1 bundle exec rake test build && ruby .github/scripts/package_smoke.rb"]
